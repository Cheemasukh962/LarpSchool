      {
        "title": "Optimization of Breeding Blanket Composition in a DT Spherical Fusion Generator",
        "start_date": "Dec 2023",
        "description": "Conducted neutronics optimization research under mentorship from UT Austin through the Polygence Program. Used OpenMC Monte Carlo simulations to model neutron flux, tritium breeding ratio (TBR), and material damage across multiple breeding blanket compositions. Identified octalithium plumbate as a promising candidate for more sustainable tritium production. Presented results at the Smart Bengal Hackathon and Polygence Research Symposium."
      },
      {
        "title": "Contiguous Regions Formed By The Diagonals Of A Regular Polygon",
        "start_date": "Apr 2023",
        "description": "Developed and proved three original mathematical formulas describing region formation in regular polygons. Generalized structural properties of adjacent, three-degree, and four-degree regions and validated proofs with custom Python simulations. Work was peer-reviewed by faculty from IIT Bombay, MIT, and Caltech."
      }
