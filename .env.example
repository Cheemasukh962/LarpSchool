# New dashboard keys (sb_publishable_ / sb_secret_) or legacy anon / service_role JWTs both work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional aliases the dashboard copies use. The code reads these too.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Public booth URL for the join QR and auth redirects. Use the deployed host, not localhost.
NEXT_PUBLIC_SITE_URL=

# Phase 4 flavor. Off unless GROQ_ENABLED and at least one key are set.
# GROQ_ENABLED=true
# GROQ_API_KEY=gsk_...
# GROQ_API_KEY_FALLBACK=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
